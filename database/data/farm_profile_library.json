  "kobra 3 max": {
    "_inherits": "kobra s1",
    "PLA": {
      "*": {
        "process": {
          "outer_wall_speed": "120"
        }
      }
    },
    "PLA+": {
      "*": {
        "process": {
          "outer_wall_speed": "120",
          "top_surface_speed": "120",
          "seam_slope_type": "none",
          "seam_slope_start_height": "10%",
          "seam_slope_min_length": "10",
